# Safe first boot: lists mailbox names only and never fetches message content.
MODE=discover

IMAP_HOST=imap.ionos.fr
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=replace@example.com
IMAP_PASSWORD=replace-locally-never-in-chat

# Set only after discovery, for example: INBOX|Sent
MAILBOXES=

# Keep the business dossier narrow. Separate terms with |.
FILTER_TERMS=replace-with-dossier-keyword
SYNC_SINCE=2026-01-01
MAX_MATCHES_PER_MAILBOX=200
MAX_ATTACHMENT_BYTES=8388608
INCLUDE_INLINE_ATTACHMENTS=false
POLL_INTERVAL_SECONDS=900

# Internal n8n URL; no host port is published by this connector.
N8N_WEBHOOK_URL=http://root-n8n-1:5678/webhook/dock-ionos-ingest
N8N_HEADER_NAME=X-DOCK-TOKEN
N8N_HEADER_VALUE=replace-locally-never-in-chat

STATE_FILE=/app/data/state.json
HEARTBEAT_FILE=/tmp/bridge-heartbeat

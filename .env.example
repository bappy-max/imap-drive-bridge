# Safe first boot: lists mailbox names only and never fetches message content.
MODE=discover

IMAP_HOST=imap.ionos.fr
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=replace@example.com
IMAP_PASSWORD_FILE=/run/secrets/imap_password

# Set only after discovery, for example: INBOX|Sent
MAILBOXES=

# Keep the business dossier narrow. Separate terms with |.
FILTER_TERMS=replace-with-dossier-keyword
SYNC_SINCE=2026-01-01
MAX_MATCHES_PER_MAILBOX=200
MAX_ATTACHMENT_BYTES=8388608
INCLUDE_INLINE_ATTACHMENTS=false
POLL_INTERVAL_SECONDS=900

# Internal n8n URL; no host port is published by this connector.
N8N_WEBHOOK_URL=http://root-n8n-1:5678/webhook/dock-ionos-ingest
N8N_HEADER_NAME=X-DOCK-TOKEN
N8N_HEADER_VALUE_FILE=/run/secrets/n8n_header

STATE_FILE=/app/data/state.json
HEARTBEAT_FILE=/tmp/bridge-heartbeat

# Internal-only SMTP gateway. It reuses the mailbox password Docker secret.
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace@example.com
SMTP_PASSWORD_FILE=/run/secrets/imap_password
SMTP_FROM=replace@example.com
SMTP_FROM_NAME=Cabinet Hemmès
SMTP_SENT_MAILBOX=Objets envoyés
SMTP_GATEWAY_PORT=3000
SMTP_GATEWAY_HEADER_NAME=X-DOCK-TOKEN
SMTP_GATEWAY_TOKEN_FILE=/run/secrets/n8n_header
SMTP_STATE_FILE=/app/smtp-data/state.json
SMTP_MAX_RECIPIENTS=10
SMTP_MAX_SUBJECT_CHARS=200
SMTP_MAX_BODY_CHARS=50000
SMTP_MAX_ATTACHMENT_COUNT=10
SMTP_MAX_ATTACHMENT_BYTES=8388608
SMTP_MAX_TOTAL_ATTACHMENT_BYTES=12582912
SMTP_MAX_REQUEST_BYTES=18874368
